# Auth (Supabase only issues the JWT; data goes through the API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google OAuth client (ADR-0023): Google returns to <origin>/auth/google, registered as a redirect URI
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Spring Boot API
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 'http' (real API) | 'mock' (in-memory adapter, no backend) | 'demo' (the mock without sign-in, ADR-0022)
VITE_API_MODE=mock
